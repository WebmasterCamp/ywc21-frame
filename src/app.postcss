/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

body {
	background-color: var(--surface);
	background-image: radial-gradient(ellipse at 50% 30%, var(--surface) 0%, var(--surface) 45%, var(--surface-deep) 140%);
	background-attachment: fixed;
	color: var(--ink-body);
	font: var(--text-body);
	min-height: 100vh;
}

:focus-visible {
	outline: 2px solid var(--focus);
	outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
	* {
		animation-duration: 0.01ms !important;
		transition-duration: 0.01ms !important;
	}
}
