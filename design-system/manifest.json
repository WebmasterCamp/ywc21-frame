  "components": [
    {
      "name": "SectionHeading",
      "group": "Layout",
      "summary": "Centred Thai section title with a small tracked English label beneath — the heading of every section on the site."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Call-to-action button — an intentional addition: the Figma source has no button yet, but the site needs \"สมัครเลย\" and secondary links."
    },
    {
      "name": "ParchmentCard",
      "group": "Content",
      "summary": "Torn-edge parchment card — used for the four \"ทำไมต้อง YWC21\" reasons and the Timeline entries."
    },
    {
      "name": "MajorTile",
      "group": "Content",
      "summary": "Tall navy-to-gold gradient tile for choosing one of the four camp majors (Content, Marketing, Programming, Design)."
    },
    {
      "name": "ScriptMarquee",
      "group": "Decoration",
      "summary": "Band of the word \"human\" written in many scripts, drifting slowly — the visual shorthand for Re:Humanize the Web."
    },
    {
      "name": "DiamondDots",
      "group": "Navigation",
      "summary": "Diamond-shaped indicator for the Gallery carousel."
    }
  ],
